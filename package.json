{
  "name": "mftik-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "node scripts/fetch-mftik-docs.mjs && vitepress dev docs",
    "docs:build": "node scripts/fetch-mftik-docs.mjs && vitepress build docs",
    "build": "npm run docs:build",
    "docs:preview": "vitepress preview docs",
    "test": "node --test scripts/rewrite-mftik-markdown.test.mjs scripts/shell.test.mjs"
  },
